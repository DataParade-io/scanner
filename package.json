{
  "name": "@dataparade/scanner",
  "version": "0.0.1",
  "description": "DataParade deterministic codebase scanner — ingest, analyzers, classifier, and data-flow detection",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "GPL-3.0-or-later",
  "author": "DataParade",
  "homepage": "https://dataparade.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DataParade-io/scanner.git"
  },
  "bugs": {
    "url": "https://github.com/DataParade-io/scanner/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dataparade",
    "privacy",
    "data-flow",
    "security",
    "scanner"
  ],
  "private": false,
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.json",
    "prepublishOnly": "pnpm run build && pnpm run test",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "pretest": "pnpm run build",
    "test": "jest"
  },
  "dependencies": {
    "typescript": "^5.7.3",
    "yaml": "^2.8.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript-eslint": "^8.20.0"
  },
  "files": [
    "dist",
    "patterns",
    "LICENSE",
    "README.md",
    "package.json"
  ]
}
